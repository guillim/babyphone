    "diagnostics.router.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a line without IPv6, the device in the baby's room asks the home router to open a port (UPnP or NAT-PMP), so it can still be reached away from home. Run this test on the device in the baby's room, on Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur une ligne sans IPv6, l'appareil côté bébé demande au routeur de la maison de lui ouvrir un port (UPnP ou NAT-PMP), pour rester joignable hors de la maison. Ce test se fait sur l'appareil côté bébé, en Wi-Fi."
          }
        }
      }
    },
    "diagnostics.router.mapped %@ %@" : {
      "extractionState" : "manual",
