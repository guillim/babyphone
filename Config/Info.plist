<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_nuzzlecam._tcp</string>
		<string>_nuzzlecam-pair._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Côté bébé, la caméra filme la chambre pour l'appareil parent. Côté parent, elle scanne le QR code d'appairage.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Les deux appareils se trouvent et se connectent directement sur votre réseau Wi-Fi.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Côté bébé, le micro écoute la chambre. Côté parent, il sert à parler à votre bébé.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
